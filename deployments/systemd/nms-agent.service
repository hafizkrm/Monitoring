[Unit]
Description=nms-agent - Network Monitoring Agent
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=nms-agent
Group=nms-agent
WorkingDirectory=/opt/nms-agent

ExecStart=/opt/nms-agent/bin/nms-agent -config /etc/nms-agent/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10

# Standard output / error
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nms-agent

# Security
NoNewPrivileges=yes
PrivateTmp=yes

# Resource limits
LimitNOFILE=65535
LimitNPROC=65535

# Timeout
TimeoutStartSec=30
TimeoutStopSec=10

# Environment
Environment="PATH=/opt/nms-agent/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
EnvironmentFile=-/etc/default/nms-agent

[Install]
WantedBy=multi-user.target

